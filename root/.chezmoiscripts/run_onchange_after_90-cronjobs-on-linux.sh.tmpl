{{- /*
  vim:ft=bash.gotmpl:
*/ -}}
#!/bin/bash

# cronjobs hash: {{ includeTemplate "cronjobs" . | sha256sum }}

{{ template "utils" }}

CRON_USER={{ .non_root_user | quote }}
BEGIN_MARK="# BEGIN chezmoi managed"
END_MARK="# END chezmoi managed"

CRONJOBS=$(cat <<'CRON'
{{ template "cronjobs" . }}
CRON
)

current=$(sudo crontab -u "${CRON_USER}" -l 2>/dev/null || true)

# INFO: keep user's own jobs, replace the managed block and drop legacy
# unmarked copies of managed lines
log_task "Installing cronjobs for ${CRON_USER}"
{
  sed "/^${BEGIN_MARK}\$/,/^${END_MARK}\$/d" <<<"${current}" |
    grep -vxF -f <(grep -v '^$' <<<"${CRONJOBS}") || true
  echo "${BEGIN_MARK}"
  echo "${CRONJOBS}"
  echo "${END_MARK}"
} | sed '/./,$!d' | sudo crontab -u "${CRON_USER}" -
