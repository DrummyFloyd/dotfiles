{{- /*
  vim:ft=bash.gotmpl:
*/ -}}
#!/usr/bin/env bash

{{ template "utils" }}

UNWANTED_PACKAGES=(
{{- range .arch.unwantedPackages }}
  {{ . | quote }}
{{- end }}
)

# INFO: keep exact names only, pacman -Qq silently skips missing ones
mapfile -t PACKAGES_TO_REMOVE < <(
  pacman -Qq "${UNWANTED_PACKAGES[@]}" 2>/dev/null |
    grep -xF -f <(printf '%s\n' "${UNWANTED_PACKAGES[@]}") || true
)

if [[ ${#PACKAGES_TO_REMOVE[@]} -gt 0 ]]; then
  log_task "Remove conflicting or unwanted packages: ${PACKAGES_TO_REMOVE[*]}"
  # INFO: -Rdd skips dependency checks instead of cascading removal (-Rc) of
  # everything depending on it; the replacement (e.g. iptables-nft) is
  # installed right after by 05-install-packages.
  sudo pacman -Rdd --noconfirm "${PACKAGES_TO_REMOVE[@]}"
fi
