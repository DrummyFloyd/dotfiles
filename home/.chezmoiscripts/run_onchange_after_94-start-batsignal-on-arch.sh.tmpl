#!/bin/bash

{{ template "utils" }}

# options.conf hash: {{ include "private_dot_config/systemd/user/batsignal.service.d/options.conf" | sha256sum }}

# Enabled by the default.target.wants link; (re)start it with its options.
if command -v batsignal >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
  log_task "Starting batsignal"
  systemctl --user daemon-reload
  systemctl --user restart batsignal.service
fi
