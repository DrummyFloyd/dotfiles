{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(glab mr create:*)"
    ],
    "deny": ["Read(*.env)", "Bash(rm:*)", "Read(*.sec)"],
    "ask": ["Bash(gh pr create:*)", "Bash(git push:*)", "Bash(kubectl exec:*)"],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.command | test(\"(^|[^|])[|]([^|]|$)\")' >/dev/null && { echo 'Pipe forbidden: use Read/Grep or separate commands.' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "crowdsec@crowdsecurity": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "crowdsecurity": {
      "source": {
        "source": "github",
        "repo": "crowdsecurity/crowdsec-skill"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
