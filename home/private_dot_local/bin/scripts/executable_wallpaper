#!/usr/bin/env bash
#
# Pick and apply the desktop wallpaper through hyprpaper IPC.
#
# Wallpapers come from the active theme (~/.local/state/theme/current/backgrounds/)
# then from ~/Pictures/Backgrounds. The auto palette takes its colours from any
# wallpaper, so it also lists the wallpapers of every palette. The chosen one is kept as the symlink
# ~/.local/state/wallpaper/current, which hyprpaper.conf loads at startup.
# A theme that follows the wallpaper is recoloured along (see the theme script).

set -euo pipefail

THEME_DIR="$HOME/.local/state/theme/current/backgrounds"
GLOBAL_DIR="$HOME/Pictures/Backgrounds"
PALETTES_DIR="$HOME/.config/themes/palettes"
STATE_DIR="$HOME/.local/state/wallpaper"
CURRENT="$STATE_DIR/current"
DEFAULT_WALLPAPER="$GLOBAL_DIR/wano-tree.jpg"
THEME="$(dirname "$(readlink -f "$0")")/theme"
# Last wallpaper highlighted in the picker, or "closed" once the picker is done;
# recolouring waits until it settles.
PREVIEW_TOKEN="${XDG_RUNTIME_DIR:-/tmp}/wallpaper-preview"
# Held to show a wallpaper, so previews and the picker's final choice apply in order.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/wallpaper.lock"
PREVIEW_DELAY=0.3

# Centered window: names on the left, the highlighted wallpaper large on the right.
LAYOUT='
window { width: 1100px; location: center; anchor: center; }
mainbox { children: [inputbar, panes]; }
panes { orientation: horizontal; spacing: 12px; children: [listview, icon-current-entry]; }
listview { lines: 12; columns: 1; }
element { children: [element-text]; }
icon-current-entry { size: 34em; expand: true; }
'

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  list            List available wallpapers
  current         Print the active wallpaper
  set <path>      Apply and keep a wallpaper
  preview <name>  Show a wallpaper without keeping it
  pick            Browse with rofi: highlight previews, Enter keeps, Esc reverts
  ensure          Point to the default wallpaper if none is set
EOF
}

# Full paths, in alphabetical order of file name; a theme wallpaper hides a
# global one of the same name.
list() {
  local dir dirs=("$THEME_DIR")
  if [[ "$("$THEME" current)" == */auto ]]; then
    dirs+=("$PALETTES_DIR"/*/backgrounds)
  fi
  dirs+=("$GLOBAL_DIR")
  for dir in "${dirs[@]}"; do
    if [[ -d "$dir" ]]; then
      find -L "$dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \)
    fi
  done | awk -F/ '!seen[$NF]++ { print $NF "\t" $0 }' | sort -f | cut -f2-
}

current() {
  readlink -f "$CURRENT" || true
}

# Run a function holding the lock.
locked() {
  (
    flock 8
    "$@"
  ) 8>"$LOCK"
}

# rofi entries show file names; map one back to its path.
resolve() {
  list | awk -F/ -v name="$1" '$NF == name { print; exit }'
}

# Show a wallpaper on every monitor, without keeping it.
apply() {
  local monitor
  for monitor in $(hyprctl monitors -j | jq -r '.[].name'); do
    hyprctl hyprpaper wallpaper "$monitor,$1,cover" >/dev/null
  done
}

set_wallpaper() {
  if [[ ! -f "$1" ]]; then
    echo "Unknown wallpaper: $1" >&2
    exit 1
  fi

  mkdir -p "$STATE_DIR"
  ln -sfn "$1" "$CURRENT"
  apply "$1"
  "$THEME" refresh "$1"
}

# The highlighted wallpaper, unless the picker has closed meanwhile.
show_preview() {
  [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" != closed ]] || return 1
  echo "$1" >"$PREVIEW_TOKEN"
  apply "$1"
}

# Its colours, if it is still the highlighted one.
recolour_preview() {
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" == "$1" ]]; then
    "$THEME" refresh "$1"
  fi
}

# Called by rofi on every highlight: the wallpaper changes at once, the theme
# colours (a waybar restart) only once the highlight settles.
preview() {
  local path
  path="$(resolve "$1")"
  [[ -n "$path" ]] || return 0

  locked show_preview "$path" || return 0
  sleep "$PREVIEW_DELAY"
  locked recolour_preview "$path"
}

# Keep the picked wallpaper, or put the previous one back. Previews still
# running find the picker closed and leave it alone.
finish_pick() {
  local choice="$1" previous="$2"
  echo closed >"$PREVIEW_TOKEN"
  if [[ -n "$choice" ]]; then
    set_wallpaper "$(resolve "$choice")"
  elif [[ -n "$previous" ]]; then
    apply "$previous"
    "$THEME" refresh "$previous"
  fi
}

pick() {
  local previous choice row
  previous="$(current)"
  row="$(list | grep -nxF -- "$previous" | cut -d: -f1 || true)"
  : >"$PREVIEW_TOKEN"

  # {entry} in double quotes: see the theme script's menu.
  choice="$(
    list | while read -r path; do
      printf '%s\0icon\x1f%s\n' "${path##*/}" "$path"
    done | rofi -dmenu -i -p wallpaper \
      -selected-row "$((${row:-1} - 1))" \
      -on-selection-changed "$0 preview \"{entry}\"" \
      -theme-str "$LAYOUT"
  )" || true

  locked finish_pick "$choice" "$previous"
}

case "${1:-}" in
  list) list ;;
  current) current ;;
  set) locked set_wallpaper "${2:?wallpaper path required}" ;;
  preview) preview "${2:?wallpaper name required}" ;;
  pick) pick ;;
  ensure)
    if [[ ! -e "$CURRENT" && -f "$DEFAULT_WALLPAPER" ]]; then
      mkdir -p "$STATE_DIR"
      ln -sfn "$DEFAULT_WALLPAPER" "$CURRENT"
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac
