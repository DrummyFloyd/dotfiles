#!/bin/bash
iDIR="$HOME/.config/icons"

# Active monitors, plus an entry to turn every monitor back on.
monitors="$(hyprctl monitors -j | jq -r '.[] | "󰍹 id: \(.id) - \(.name)"')
󰍺 all monitors - all"
# Connected ones, disabled included: with one disabled there is still a choice.
connected=$(hyprctl monitors all -j | jq '. | length')

# show rofi menu

notify_user() {
  notify-send -u low -i "${iDIR}/hyprland.png" "${1}"
}

check_if_only_one_monitor() {
  if [ "${1}" == "1" ]; then
    notify_user "Only one monitor is detected"
    exit 1
  else
    echo "DEBUG: More than one monitor is detected => ${1}"
  fi
}

disable_monitor() {
  if [[ "${1}" == "all" ]]; then
    # A reload re-applies every monitor spec from the machine profile.
    # Disabling a monitor after a reload crashes Hyprland 0.56.2, so the
    # choice made here is not kept across reloads, and disabling one right
    # after "all" may crash it (see the Known issue in ~/.config/themes/README.md).
    hyprctl reload >/dev/null
    notify_user "All monitors enabled"
    return
  fi

  disabled_monitor=$(hyprctl monitors -j | jq -r --arg name "${1}" '.[] | select(.name != $name ) | .name')
  if [[ "${disabled_monitor}" == *"${1}"* ]]; then
    echo "Script Canceled or No monitor to disable or issue with the monitor switch"
    echo "DEBUG: \$disabled_monitor=> ${disabled_monitor//$'\n'/ }"
  else
    while read -r monitor; do
      [ -z "${monitor}" ] && continue
      hyprctl eval "hl.monitor({ output = \"${monitor}\", disabled = true })"
    done <<<"${disabled_monitor}"
    notify_user "Monitor Dropped: ${disabled_monitor//$'\n'/ }"
    notify_user "Main Monitor: ${selected_monitor}"
    # INFO: Restart dunst to fix the issue with the notification
    systemctl --user restart dunst.service
  fi
}

# disable all monitors except the selected one
check_if_only_one_monitor "${connected}"
# used trap to avoid issue on rofi exit
selected_monitor=$(echo -e "${monitors}" | rofi -dmenu -p "Select Monitor" -l "$(wc -l <<<"${monitors}")" -theme-str 'window { width: 15%; }' | awk $'{print $NF}')
trap 'disable_monitor "${selected_monitor}"' EXIT

# kill all rofi instances
pkill -x rofi
