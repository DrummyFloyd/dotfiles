#!/usr/bin/env bash
#
# Switch the desktop theme: a style rendered with a palette.
#
#   ~/.config/themes/styles/<style>/     templates (waybar, rofi, hyprland…) using
#                                        palette roles such as {{palette.accent}},
#                                        plus palette.json, the style's "default"
#   ~/.config/themes/palettes/<name>/    palette.json, optional backgrounds/ and upstream/
#   auto                                 palette matugen computes from the wallpaper
#   ~/.config/themes/apps/<app>/         templates for apps outside the style (kitty, ghostty, gtk, dunst, zen…)
#   ~/.config/themes/settings.json       per app: follow the theme, and the auto palette
#
# matugen renders the style and the apps with the palette into
# ~/.local/state/theme/current/, the directory every app config reads.

set -euo pipefail
shopt -s nullglob

THEMES_DIR="$HOME/.config/themes"
STYLES_DIR="$THEMES_DIR/styles"
PALETTES_DIR="$THEMES_DIR/palettes"
APPS_DIR="$THEMES_DIR/apps"
SETTINGS="$THEMES_DIR/settings.json"
# Generated files; the auto dir matches the output_path of ~/.config/matugen/config.toml.
STATE_DIR="$HOME/.local/state/theme"
CURRENT="$STATE_DIR/current"
AUTO_DIR="$STATE_DIR/auto"
MATUGEN_CONFIG="$HOME/.config/matugen/config.toml"
WALLPAPER="$(dirname "$(readlink -f "$0")")/wallpaper"
DEFAULT_STYLE="galet"
DEFAULT_PALETTE="tokyonight"
# Held while rendering and reloading, so pickers and wallpaper changes queue up.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/theme.lock"
# Last entry highlighted in a picker; previews only apply once it settles.
PREVIEW_TOKEN="${XDG_RUNTIME_DIR:-/tmp}/theme-preview"
PREVIEW_DELAY=0.3

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  current               Print the active style/palette
  styles | palettes     List the styles, or the palettes for the active style
  set <style> <palette> Activate a combination
  style <name>          Change the style, keep the palette
  palette <name>        Change the palette, keep the style
  default               Activate $DEFAULT_STYLE/$DEFAULT_PALETTE
  menu style|palette    Browse with rofi: highlight previews, Enter keeps, Esc reverts
  preview style|palette <name>  Show without notifying (debounced)
  refresh [image]       Recolour from the wallpaper if the palette is auto
  freeze [name]         Save the auto palette (name: the wallpaper's)
  check                 Check every palette defines the roles the templates use
  ensure                Render and reload the saved theme, or the default one
EOF
}

# Wait for any other render to finish; released when this script exits.
lock() {
  exec 9>"$LOCK"
  flock 9
}

active_style() {
  cat "$STATE_DIR/style" 2>/dev/null || echo "$DEFAULT_STYLE"
}

active_palette() {
  cat "$STATE_DIR/palette" 2>/dev/null || echo "$DEFAULT_PALETTE"
}

styles() {
  find "$STYLES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

# Palettes usable with a style, in alphabetical order: its own default, the
# shared ones, auto.
palettes() {
  local style="${1:-$(active_style)}"
  {
    if [[ -f "$STYLES_DIR/$style/palette.json" ]]; then
      echo default
    fi
    find "$PALETTES_DIR" -mindepth 2 -maxdepth 2 -name palette.json -printf '%h\n' |
      sed 's|.*/||'
    if command -v matugen >/dev/null; then
      echo auto
    fi
  } | sort
}

# Directory holding a palette's palette.json and optional backgrounds/ and upstream/.
palette_dir() {
  case "$2" in
    default) echo "$STYLES_DIR/$1" ;;
    auto) echo "$AUTO_DIR" ;;
    *) echo "$PALETTES_DIR/$2" ;;
  esac
}

# Which image colour seeds the auto palette, from settings.json: "dominant"
# (the most present one), or a matugen --prefer value such as "saturation".
# auto.wallpapers overrides it per wallpaper file name.
auto_rule() {
  jq -r --arg name "${1##*/}" \
    '.auto.wallpapers[$name] // .auto.prefer // "dominant"' "$SETTINGS" 2>/dev/null ||
    echo dominant
}

# What the auto palette was computed from: wallpaper, rule, and the matugen
# config and template, so editing them recomputes it too.
auto_key() {
  echo "$1 $(auto_rule "$1") $(cat "$MATUGEN_CONFIG" "${MATUGEN_CONFIG%/*}/templates/auto.json" | sha1sum | cut -c1-12)"
}

# Whether the auto palette already comes from this wallpaper.
auto_is_from() {
  [[ "$(cat "$AUTO_DIR/key" 2>/dev/null)" == "$(auto_key "$1")" ]]
}

# Recompute the auto palette from a wallpaper (default: the current one),
# unless it already comes from it.
generate_auto() {
  local image="${1:-$("$WALLPAPER" current)}" rule seed
  if [[ ! -f "$image" ]] || auto_is_from "$image"; then
    return 0
  fi

  rule="$(auto_rule "$image")"
  if [[ "$rule" == dominant ]]; then
    seed=(--source-color-index 0)
  else
    seed=(--prefer "$rule")
  fi
  matugen image "$image" --config "$MATUGEN_CONFIG" \
    --mode dark "${seed[@]}" --quiet </dev/null
  echo "$image" >"$AUTO_DIR/source"
  auto_key "$image" >"$AUTO_DIR/key"
}

# Value of an app setting from settings.json: true, false or null when unset.
setting() {
  jq -r --arg app "$1" --arg key "$2" '.[$app][$key]' "$SETTINGS" 2>/dev/null || echo null
}

# Whether an app takes its colours from the palette, per settings.json.
follows() {
  local app="$1" palette="$2"
  [[ "$(setting "$app" follow)" != false ]] &&
    [[ "$palette" != auto || "$(setting "$app" follow_auto)" != false ]]
}

# Add the templates of a directory to a matugen config, rendered into out,
# except the file names given after it.
add_templates() {
  local config="$1" out="$2" dir="$3" file
  shift 3
  for file in "$dir"/*; do
    [[ "${file##*/}" == palette.json ]] && continue
    [[ " $* " == *" ${file##*/} "* ]] && continue
    printf '[templates."%s"]\ninput_path = "%s"\noutput_path = "%s"\n\n' \
      "${file##*/}" "$file" "$out/${file##*/}" >>"$config"
  done
}

# Render the style and the apps with the palette into $CURRENT. The auto
# palette is first brought up to date with the wallpaper (default: the current one).
render() {
  local style="$1" palette="$2" image="${3:-}" dir config out app file name
  local off=() styled=()
  dir="$(palette_dir "$style" "$palette")"
  if [[ ! -d "$STYLES_DIR/$style" ]]; then
    echo "Unknown style: $style" >&2
    return 1
  fi
  if [[ "$palette" == auto ]]; then
    generate_auto "$image"
  fi
  if [[ ! -f "$dir/palette.json" ]]; then
    echo "Unknown palette: $palette" >&2
    return 1
  fi

  # Rendered aside then moved in, so apps never read a half-written current/
  # and a failed render leaves the previous theme in place. Same filesystem as
  # current/, so each move is an atomic rename.
  mkdir -p "$STATE_DIR"
  out="$(mktemp -d "$STATE_DIR/.render.XXXXXX")"
  config="$(mktemp --suffix .toml)"
  printf '[config]\n\n' >"$config"
  # apps/ holds the default files of each app; a style may replace one with a
  # file of the same name. An app that doesn't follow the theme gets neither.
  for app in "$APPS_DIR"/*/; do
    if ! follows "$(basename "$app")" "$palette"; then
      for file in "$app"*; do
        off+=("${file##*/}")
      done
    fi
  done
  for file in "$STYLES_DIR/$style"/*; do
    styled+=("${file##*/}")
  done

  add_templates "$config" "$out" "$STYLES_DIR/$style" "${off[@]}"
  for app in "$APPS_DIR"/*/; do
    add_templates "$config" "$out" "$app" "${off[@]}" "${styled[@]}"
  done

  if ! matugen color hex "#000000" --config "$config" \
    --import-json "$dir/palette.json" --quiet </dev/null; then
    rm -rf "$out" "$config"
    echo "Rendering $style/$palette failed" >&2
    return 1
  fi
  rm "$config"

  # An app keeping its own theme gets empty files: its config still includes them.
  for name in "${off[@]}"; do
    : >"$out/$name"
  done

  # A palette may ship an app's upstream theme in upstream/: it replaces the
  # rendered file of the same name, unless the app keeps its own theme.
  for file in "$dir/upstream"/*; do
    [[ " ${off[*]} " == *" ${file##*/} "* ]] && continue
    cp "$file" "$out/${file##*/}"
  done

  if [[ -d "$dir/backgrounds" ]]; then
    ln -s "$dir/backgrounds" "$out/backgrounds"
  fi

  write_nvim "$palette" "$dir/palette.json" "$out/nvim.json"

  mkdir -p "$CURRENT"
  # Drop what the new theme no longer has, then rename each file over the old
  # one (-T: replace the backgrounds link itself, not move into its target).
  for file in "$CURRENT"/*; do
    if [[ ! -e "$out/${file##*/}" && ! -L "$out/${file##*/}" ]]; then
      rm -rf "$file"
    fi
  done
  for file in "$out"/*; do
    mv -fT "$file" "$CURRENT/${file##*/}"
  done
  rmdir "$out"
}

# nvim reads (and watches) this file from lua/plugins/colorscheme.lua: a palette
# may name a native colorscheme, otherwise nvim builds one from the palette.
write_nvim() {
  local follow=false
  if follows nvim "$1"; then
    follow=true
  fi

  # Unset keys are left out: nvim then uses its own fallback colorscheme.
  jq --argjson follow "$follow" \
    --argjson fallback "$(jq -c '.nvim.fallback' "$SETTINGS" 2>/dev/null || echo null)" \
    '{follow: $follow, fallback: $fallback, colorscheme: .nvim.colorscheme, palette: .palette}
      | with_entries(select(.value != null))' \
    "$2" >"$3"
}

notify() {
  notify-send -u low -i "$HOME/.config/icons/hyprland.png" \
    -h string:x-canonical-private-synchronous:theme "Theme: $1"
}

reload() {
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    return
  fi

  # Only re-apply the theme look: a full `hyprctl reload` re-enables monitors
  # turned off at runtime and makes Hyprland 0.56 crash on the next monitor change.
  hyprctl eval "dofile(os.getenv('HOME') .. '/.config/hypr/config/theme.lua')" >/dev/null
  # waybar segfaults on a SIGUSR2 reload when the module layout changes,
  # so restart it the way config/autostart.lua starts it.
  pkill -x waybar || true
  while pgrep -x waybar >/dev/null; do
    sleep 0.05
  done
  hyprctl eval 'hl.exec_cmd("uwsm app -- waybar")' >/dev/null
  # kitty re-reads its config (and the included colours) on SIGUSR1.
  pkill -USR1 -x kitty || true
  # Ghostty reloads its config (colours and custom CSS) on SIGUSR2.
  pkill -USR2 -x ghostty || true
  # dunst re-reads dunstrc and its dunstrc.d/ drop-ins (the theme colours).
  dunstctl reload >/dev/null 2>&1 || true
  # GTK apps re-read their style (and gtk.css) when the GTK theme changes.
  local gtk_theme
  gtk_theme="$(gsettings get org.gnome.desktop.interface gtk-theme)"
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
}

# Render, remember and show a combination.
save() {
  mkdir -p "$STATE_DIR"
  echo "$1" >"$STATE_DIR/style"
  echo "$2" >"$STATE_DIR/palette"
}

activate() {
  lock
  render "$1" "$2"
  save "$1" "$2"
  reload
}

# Render the saved theme and reload the apps; if it is gone, switch to the
# default one for good.
ensure() {
  lock
  if ! render "$(active_style)" "$(active_palette)"; then
    echo "Switching to $DEFAULT_STYLE/$DEFAULT_PALETTE" >&2
    render "$DEFAULT_STYLE" "$DEFAULT_PALETTE"
    save "$DEFAULT_STYLE" "$DEFAULT_PALETTE"
  fi
  reload
}

# Palette to use with a style: the active one when the style can use it.
style_palette() {
  local palette
  palette="$(active_palette)"
  # grep -q would stop reading early and fail the pipeline (pipefail).
  if ! palettes "$1" | grep -xF -- "$palette" >/dev/null; then
    palette="$DEFAULT_PALETTE"
  fi
  echo "$palette"
}

set_theme() {
  activate "$1" "$2"
  notify "$1/$2"
}

# Called by rofi on every highlight: rendering and restarting waybar is slow,
# so only the entry still highlighted after PREVIEW_DELAY is applied.
preview() {
  local kind="$1" name="$2"
  echo "$kind $name" >"$PREVIEW_TOKEN"
  sleep "$PREVIEW_DELAY"
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" != "$kind $name" ]]; then
    return 0
  fi
  # A previous preview may still be rendering; skip if the highlight moved on
  # while waiting for it.
  lock
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" != "$kind $name" ]]; then
    return 0
  fi

  case "$kind" in
    style)
      [[ "$name" != "$(active_style)" ]] || return 0
      render "$name" "$(style_palette "$name")"
      ;;
    palette)
      palettes | grep -xF -- "$name" >/dev/null || return 0
      render "$(active_style)" "$name"
      ;;
  esac
  touch "$PREVIEW_TOKEN.shown"
  reload
}

menu() {
  local kind="$1" active choice row
  case "$kind" in
    style) active="$(active_style)" ;;
    palette) active="$(active_palette)" ;;
    *) usage; exit 1 ;;
  esac
  row="$("${kind}s" | grep -nxF -- "$active" | cut -d: -f1 || true)"
  rm -f "$PREVIEW_TOKEN.shown"

  # rofi pastes {entry} as is, then splits the command like a shell: double
  # quotes keep names with spaces or ' whole (only " and \ would break them).
  choice="$("${kind}s" | rofi -dmenu -i -p "$kind" \
    -selected-row "$((${row:-1} - 1))" \
    -on-selection-changed "$0 preview $kind \"{entry}\"")" || true

  # Cancel any preview still waiting to fire.
  : >"$PREVIEW_TOKEN"

  if [[ -z "$choice" ]]; then
    # Previews only rendered; put the saved theme back.
    if [[ -e "$PREVIEW_TOKEN.shown" ]]; then
      lock
      render "$(active_style)" "$(active_palette)"
      reload
    fi
  elif [[ "$kind" == style ]]; then
    set_theme "$choice" "$(style_palette "$choice")"
  else
    set_theme "$(active_style)" "$choice"
  fi
}

# Wallpaper changed: recolour when the palette follows it.
refresh() {
  local image="${1:-$("$WALLPAPER" current)}"
  lock
  if [[ "$(active_palette)" != auto ]] || auto_is_from "$image"; then
    return 0
  fi

  render "$(active_style)" auto "$image"
  reload
}

# Every palette (the styles' defaults, the shared ones, and the matugen template
# of the auto one) must define each {{palette.<role>}} the templates use.
check() {
  local roles file keys missing status=0
  roles="$(grep -rhoE '\{\{ *palette\.[a-z0-9_]+' "$STYLES_DIR" "$APPS_DIR" |
    sed -E 's/.*palette\.//' | sort -u)"

  for file in "$STYLES_DIR"/*/palette.json "$PALETTES_DIR"/*/palette.json \
    "${MATUGEN_CONFIG%/*}/templates/auto.json"; do
    if ! keys="$(jq -r '.palette | keys[]' "$file" 2>/dev/null | sort)"; then
      echo "$file: not a palette JSON file" >&2
      status=1
      continue
    fi
    missing="$(comm -23 <(echo "$roles") <(echo "$keys") | paste -sd' ')"
    if [[ -n "$missing" ]]; then
      echo "$file: missing $missing" >&2
      status=1
    fi
  done

  if ((status == 0)); then
    echo "Every palette defines the $(wc -l <<<"$roles") roles the templates use"
  fi
  return "$status"
}

# Keep the auto palette as palettes/<name>/, with the wallpaper it came from.
freeze() {
  local source name
  source="$(cat "$AUTO_DIR/source" 2>/dev/null || true)"
  if [[ ! -f "$AUTO_DIR/palette.json" || -z "$source" ]]; then
    echo "No auto palette yet: pick the auto palette first" >&2
    exit 1
  fi
  name="${1:-$(basename "${source%.*}")}"

  mkdir -p "$PALETTES_DIR/$name/backgrounds"
  cp "$AUTO_DIR/palette.json" "$PALETTES_DIR/$name/palette.json"
  ln -sfn "$source" "$PALETTES_DIR/$name/backgrounds/${source##*/}"
  echo "Saved $PALETTES_DIR/$name (add it to chezmoi to keep it)"
}

case "${1:-}" in
  current) echo "$(active_style)/$(active_palette)" ;;
  styles) styles ;;
  palettes) palettes ;;
  set) set_theme "${2:?style required}" "${3:?palette required}" ;;
  style) set_theme "${2:?style required}" "$(style_palette "$2")" ;;
  palette) set_theme "$(active_style)" "${2:?palette required}" ;;
  default) set_theme "$DEFAULT_STYLE" "$DEFAULT_PALETTE" ;;
  menu) menu "${2:?style or palette required}" ;;
  preview) preview "${2:?style or palette required}" "${3:?name required}" ;;
  refresh) refresh "${2:-}" ;;
  freeze) freeze "${2:-}" ;;
  check) check ;;
  ensure) ensure ;;
  *)
    usage
    exit 1
    ;;
esac
