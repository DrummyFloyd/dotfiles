#!/usr/bin/env bash
#
# Switch the desktop theme: a style rendered with a palette.
#
#   ~/.config/themes/styles/<style>/     templates (waybar, rofi, hyprland…) using
#                                        palette roles such as {{palette.accent}},
#                                        plus palette.json, the style's "default"
#   ~/.config/themes/palettes/<name>/    palette.json, optional backgrounds/
#   auto                                 palette matugen computes from the wallpaper
#
# matugen renders the style with the palette into ~/.config/themes/current/,
# the directory every app config reads.

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
STYLES_DIR="$THEMES_DIR/styles"
PALETTES_DIR="$THEMES_DIR/palettes"
CURRENT="$THEMES_DIR/current"
# Matches the output_path of ~/.config/matugen/config.toml.
STATE_DIR="$HOME/.local/state/theme"
AUTO_DIR="$STATE_DIR/auto"
MATUGEN_CONFIG="$HOME/.config/matugen/config.toml"
WALLPAPER="$(dirname "$(readlink -f "$0")")/wallpaper"
DEFAULT_STYLE="galet"
DEFAULT_PALETTE="default"
# Last entry highlighted in a picker; previews only apply once it settles.
PREVIEW_TOKEN="${XDG_RUNTIME_DIR:-/tmp}/theme-preview"
PREVIEW_DELAY=0.3

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  current               Print the active style/palette
  styles | palettes     List the styles, or the palettes for the active style
  set <style> <palette> Activate a combination
  style <name>          Change the style, keep the palette
  palette <name>        Change the palette, keep the style
  default               Activate $DEFAULT_STYLE/$DEFAULT_PALETTE
  menu style|palette    Browse with rofi: highlight previews, Enter keeps, Esc reverts
  preview style|palette <name>  Show without notifying (debounced)
  refresh [image]       Recolour from the wallpaper if the palette is auto
  freeze [name]         Save the auto palette (name: the wallpaper's)
  ensure                Render the saved theme, or the default one
EOF
}

active_style() {
  cat "$STATE_DIR/style" 2>/dev/null || echo "$DEFAULT_STYLE"
}

active_palette() {
  cat "$STATE_DIR/palette" 2>/dev/null || echo "$DEFAULT_PALETTE"
}

styles() {
  find "$STYLES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

# Palettes usable with a style: its own default, the shared ones, auto.
palettes() {
  local style="${1:-$(active_style)}"
  if [[ -f "$STYLES_DIR/$style/palette.json" ]]; then
    echo default
  fi
  find "$PALETTES_DIR" -mindepth 2 -maxdepth 2 -name palette.json -printf '%h\n' |
    xargs -r -n1 basename | sort
  if command -v matugen >/dev/null; then
    echo auto
  fi
}

# Directory holding a palette's palette.json and optional backgrounds/.
palette_dir() {
  case "$2" in
    default) echo "$STYLES_DIR/$1" ;;
    auto) echo "$AUTO_DIR" ;;
    *) echo "$PALETTES_DIR/$2" ;;
  esac
}

# Recompute the auto palette, unless it already comes from this wallpaper.
generate_auto() {
  local image="${1:-$("$WALLPAPER" current)}"
  if [[ ! -f "$image" || "$(cat "$AUTO_DIR/source" 2>/dev/null)" == "$image" ]]; then
    return 0
  fi

  matugen image "$image" --config "$MATUGEN_CONFIG" \
    --mode dark --prefer saturation --quiet </dev/null
  echo "$image" >"$AUTO_DIR/source"
}

# Render every file of the style with the palette into $CURRENT.
render() {
  local style="$1" palette="$2" dir config file
  dir="$(palette_dir "$style" "$palette")"
  if [[ ! -d "$STYLES_DIR/$style" ]]; then
    echo "Unknown style: $style" >&2
    exit 1
  fi
  if [[ "$palette" == auto && ! -f "$dir/palette.json" ]]; then
    generate_auto
  fi
  if [[ ! -f "$dir/palette.json" ]]; then
    echo "Unknown palette: $palette" >&2
    exit 1
  fi

  config="$(mktemp --suffix .toml)"
  printf '[config]\n\n' >"$config"
  for file in "$STYLES_DIR/$style"/*; do
    [[ "${file##*/}" == palette.json ]] && continue
    printf '[templates."%s"]\ninput_path = "%s"\noutput_path = "%s"\n\n' \
      "${file##*/}" "$file" "$CURRENT/${file##*/}" >>"$config"
  done

  # current used to be a symlink to a theme directory.
  if [[ -L "$CURRENT" ]]; then
    rm "$CURRENT"
  fi
  mkdir -p "$CURRENT"
  find "$CURRENT" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  matugen color hex "#000000" --config "$config" \
    --import-json "$dir/palette.json" --quiet </dev/null
  rm "$config"

  if [[ -d "$dir/backgrounds" ]]; then
    ln -s "$dir/backgrounds" "$CURRENT/backgrounds"
  fi
}

notify() {
  notify-send -u low -i "$HOME/.config/icons/hyprland.png" \
    -h string:x-canonical-private-synchronous:theme "Theme: $1"
}

reload() {
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    return
  fi

  # Only re-apply the theme look: a full `hyprctl reload` re-enables monitors
  # turned off at runtime and makes Hyprland 0.56 crash on the next monitor change.
  hyprctl eval "dofile(os.getenv('HOME') .. '/.config/hypr/config/theme.lua')" >/dev/null
  # waybar segfaults on a SIGUSR2 reload when the module layout changes,
  # so restart it the way config/autostart.lua starts it.
  pkill -x waybar || true
  while pgrep -x waybar >/dev/null; do
    sleep 0.05
  done
  hyprctl eval 'hl.exec_cmd("uwsm app -- waybar")' >/dev/null
}

# Render, remember and show a combination.
activate() {
  if [[ "$2" == auto ]]; then
    generate_auto
  fi
  render "$1" "$2"
  mkdir -p "$STATE_DIR"
  echo "$1" >"$STATE_DIR/style"
  echo "$2" >"$STATE_DIR/palette"
  reload
}

# A style change keeps the palette when the new style can use it.
with_style() {
  local palette
  palette="$(active_palette)"
  if ! palettes "$1" | grep -qxF -- "$palette"; then
    palette="$DEFAULT_PALETTE"
  fi
  echo "$1 $palette"
}

set_theme() {
  activate "$1" "$2"
  notify "$1/$2"
}

# Called by rofi on every highlight: rendering and restarting waybar is slow,
# so only the entry still highlighted after PREVIEW_DELAY is applied.
preview() {
  local kind="$1" name="$2"
  echo "$kind $name" >"$PREVIEW_TOKEN"
  sleep "$PREVIEW_DELAY"
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" != "$kind $name" ]]; then
    return 0
  fi

  case "$kind" in
    style)
      [[ "$name" != "$(active_style)" ]] || return 0
      # shellcheck disable=SC2046
      render $(with_style "$name")
      ;;
    palette)
      palettes | grep -qxF -- "$name" || return 0
      if [[ "$name" == auto ]]; then
        generate_auto
      fi
      render "$(active_style)" "$name"
      ;;
  esac
  touch "$PREVIEW_TOKEN.shown"
  reload
}

menu() {
  local kind="$1" active choice row
  case "$kind" in
    style) active="$(active_style)" ;;
    palette) active="$(active_palette)" ;;
    *) usage; exit 1 ;;
  esac
  row="$("${kind}s" | grep -nxF -- "$active" | cut -d: -f1 || true)"
  rm -f "$PREVIEW_TOKEN.shown"

  choice="$("${kind}s" | rofi -dmenu -i -p "$kind" \
    -selected-row "$((${row:-1} - 1))" \
    -on-selection-changed "$0 preview $kind '{entry}'")" || true

  # Cancel any preview still waiting to fire.
  : >"$PREVIEW_TOKEN"

  if [[ -z "$choice" ]]; then
    # Previews only rendered; put the saved theme back.
    if [[ -e "$PREVIEW_TOKEN.shown" ]]; then
      render "$(active_style)" "$(active_palette)"
      reload
    fi
  elif [[ "$kind" == style ]]; then
    # shellcheck disable=SC2046
    set_theme $(with_style "$choice")
  else
    set_theme "$(active_style)" "$choice"
  fi
}

# Wallpaper changed: recolour when the palette follows it.
refresh() {
  local image="${1:-$("$WALLPAPER" current)}"
  if [[ "$(active_palette)" != auto || "$(cat "$AUTO_DIR/source" 2>/dev/null)" == "$image" ]]; then
    return 0
  fi

  generate_auto "$image"
  render "$(active_style)" auto
  reload
}

# Keep the auto palette as palettes/<name>/, with the wallpaper it came from.
freeze() {
  local source name
  source="$(cat "$AUTO_DIR/source" 2>/dev/null || true)"
  if [[ ! -f "$AUTO_DIR/palette.json" || -z "$source" ]]; then
    echo "No auto palette yet: pick the auto palette first" >&2
    exit 1
  fi
  name="${1:-$(basename "${source%.*}")}"

  mkdir -p "$PALETTES_DIR/$name/backgrounds"
  cp "$AUTO_DIR/palette.json" "$PALETTES_DIR/$name/palette.json"
  ln -sfn "$source" "$PALETTES_DIR/$name/backgrounds/${source##*/}"
  echo "Saved $PALETTES_DIR/$name (add it to chezmoi to keep it)"
}

case "${1:-}" in
  current) echo "$(active_style)/$(active_palette)" ;;
  styles) styles ;;
  palettes) palettes ;;
  set) set_theme "${2:?style required}" "${3:?palette required}" ;;
  # shellcheck disable=SC2046
  style) set_theme $(with_style "${2:?style required}") ;;
  palette) set_theme "$(active_style)" "${2:?palette required}" ;;
  default) set_theme "$DEFAULT_STYLE" "$DEFAULT_PALETTE" ;;
  menu) menu "${2:?style or palette required}" ;;
  preview) preview "${2:?style or palette required}" "${3:?name required}" ;;
  refresh) refresh "${2:-}" ;;
  freeze) freeze "${2:-}" ;;
  ensure)
    if [[ "$(active_palette)" == auto ]]; then
      generate_auto || true
    fi
    render "$(active_style)" "$(active_palette)" || render "$DEFAULT_STYLE" "$DEFAULT_PALETTE"
    ;;
  *)
    usage
    exit 1
    ;;
esac
