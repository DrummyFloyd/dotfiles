#!/usr/bin/env bash
#
# Switch the desktop theme.
#
# A theme is a directory ~/.config/themes/<name>/ providing any of:
#   waybar.jsonc  waybar.css  wofi.css  hyprland.lua
# ~/.config/themes/current is a symlink to the active one; every app config
# reads its theme file through it.

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"
DEFAULT_THEME="galet-dark"
# Last theme highlighted in the picker; previews only apply once it settles.
PREVIEW_TOKEN="${XDG_RUNTIME_DIR:-/tmp}/theme-preview"
PREVIEW_DELAY=0.3

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  list            List available themes
  current         Print the active theme
  set <name>      Activate a theme
  next | prev     Cycle through themes
  default         Activate the default theme ($DEFAULT_THEME)
  preview <name>  Show a theme without notifying (debounced)
  menu            Browse with rofi: highlight previews, Enter keeps, Esc reverts
  ensure          Point to the default theme if none is active
EOF
}

list() {
  find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

current() {
  if [[ -d "$CURRENT" ]]; then
    basename "$(readlink "$CURRENT")"
  fi
}

notify() {
  notify-send -u low -i "$HOME/.config/icons/hyprland.png" \
    -h string:x-canonical-private-synchronous:theme "Theme: $1"
}

reload() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload >/dev/null
  fi
  pkill -USR2 -x waybar || true
}

set_theme() {
  local name="$1"

  if [[ ! -d "$THEMES_DIR/$name" ]]; then
    echo "Unknown theme: $name" >&2
    exit 1
  fi

  activate "$name"
  notify "$name"
}

activate() {
  ln -sfn "$1" "$CURRENT"
  reload
}

# Called by rofi on every highlight: reloading Hyprland and waybar is slow,
# so only the entry still highlighted after PREVIEW_DELAY is applied.
preview() {
  local name="$1"
  [[ -d "$THEMES_DIR/$name" ]] || return 0

  echo "$name" >"$PREVIEW_TOKEN"
  sleep "$PREVIEW_DELAY"
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" == "$name" && "$(current)" != "$name" ]]; then
    activate "$name"
  fi
}

menu() {
  local previous choice row
  previous="$(current)"
  row="$(list | grep -nxF -- "$previous" | cut -d: -f1 || true)"

  choice="$(list | rofi -dmenu -i -p theme \
    -selected-row "$((${row:-1} - 1))" \
    -on-selection-changed "$0 preview '{entry}'")" || true

  # Cancel any preview still waiting to fire.
  : >"$PREVIEW_TOKEN"

  if [[ -n "$choice" ]]; then
    set_theme "$choice"
  elif [[ -n "$previous" && "$(current)" != "$previous" ]]; then
    activate "$previous"
  fi
}

cycle() {
  local step="$1" themes active i
  mapfile -t themes < <(list)
  active="$(current)"

  for i in "${!themes[@]}"; do
    if [[ "${themes[$i]}" == "$active" ]]; then
      set_theme "${themes[$(((i + step + ${#themes[@]}) % ${#themes[@]}))]}"
      return
    fi
  done
  set_theme "${themes[0]}"
}

case "${1:-}" in
  list) list ;;
  current) current ;;
  set) set_theme "${2:?theme name required}" ;;
  next) cycle 1 ;;
  prev) cycle -1 ;;
  default) set_theme "$DEFAULT_THEME" ;;
  preview) preview "${2:?theme name required}" ;;
  menu) menu ;;
  ensure)
    if [[ ! -d "$CURRENT" && -d "$THEMES_DIR/$DEFAULT_THEME" ]]; then
      ln -sfn "$DEFAULT_THEME" "$CURRENT"
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac
