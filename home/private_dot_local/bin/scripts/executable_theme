#!/usr/bin/env bash
#
# Switch the desktop theme.
#
# A theme is a directory ~/.config/themes/<name>/ providing any of:
#   waybar.jsonc  waybar.css  rofi.rasi  hyprland.lua
# ~/.config/themes/current is a symlink to the active one; every app config
# reads its theme file through it.
#
# A theme with templates in ~/.config/matugen/templates/<name>/ follows the
# wallpaper: matugen renders its files from the current wallpaper.

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"
DEFAULT_THEME="galet-dark"
# Last theme highlighted in the picker; previews only apply once it settles.
PREVIEW_TOKEN="${XDG_RUNTIME_DIR:-/tmp}/theme-preview"
PREVIEW_DELAY=0.3
MATUGEN_DIR="$HOME/.config/matugen"
MATUGEN_TEMPLATES="$MATUGEN_DIR/templates"
# Wallpaper the generated colours come from, to skip regenerating them.
COLORS_SOURCE="${XDG_RUNTIME_DIR:-/tmp}/theme-colors-source"
WALLPAPER="$(dirname "$(readlink -f "$0")")/wallpaper"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  list            List available themes
  current         Print the active theme
  set <name>      Activate a theme
  next | prev     Cycle through themes
  default         Activate the default theme ($DEFAULT_THEME)
  preview <name>  Show a theme without notifying (debounced)
  generate [img]  Render the wallpaper-coloured themes (default: current wallpaper)
  refresh [img]   Regenerate and reload if the active theme follows the wallpaper
  menu            Browse with rofi: highlight previews, Enter keeps, Esc reverts
  ensure          Point to the default theme if none is active
EOF
}

list() {
  find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

current() {
  if [[ -d "$CURRENT" ]]; then
    basename "$(readlink "$CURRENT")"
  fi
}

notify() {
  notify-send -u low -i "$HOME/.config/icons/hyprland.png" \
    -h string:x-canonical-private-synchronous:theme "Theme: $1"
}

reload() {
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    return
  fi

  hyprctl reload >/dev/null
  # waybar segfaults on a SIGUSR2 reload when the module layout changes,
  # so restart it the way config/autostart.lua starts it.
  pkill -x waybar || true
  while pgrep -x waybar >/dev/null; do
    sleep 0.05
  done
  hyprctl eval 'hl.exec_cmd("uwsm app -- waybar")' >/dev/null
}

set_theme() {
  local name="$1"

  if [[ ! -d "$THEMES_DIR/$name" ]]; then
    echo "Unknown theme: $name" >&2
    exit 1
  fi

  activate "$name"
  notify "$name"
}

follows_wallpaper() {
  [[ -d "$MATUGEN_TEMPLATES/$1" ]]
}

generate() {
  local image="${1:-$("$WALLPAPER" current)}"
  if ! command -v matugen >/dev/null || [[ ! -f "$image" ]]; then
    return 1
  fi

  matugen image "$image" --config "$MATUGEN_DIR/config.toml" \
    --mode dark --prefer saturation --quiet </dev/null
  echo "$image" >"$COLORS_SOURCE"
}

# Regenerate only when the wallpaper differs from the one last used.
refresh() {
  local image="${1:-$("$WALLPAPER" current)}"
  if ! follows_wallpaper "$(current)" || [[ "$(cat "$COLORS_SOURCE" 2>/dev/null)" == "$image" ]]; then
    return 0
  fi

  if generate "$image"; then
    reload
  fi
}

activate() {
  if follows_wallpaper "$1" && [[ "$(cat "$COLORS_SOURCE" 2>/dev/null)" != "$("$WALLPAPER" current)" ]]; then
    generate || true
  fi
  ln -sfn "$1" "$CURRENT"
  reload
}

# Called by rofi on every highlight: reloading Hyprland and waybar is slow,
# so only the entry still highlighted after PREVIEW_DELAY is applied.
preview() {
  local name="$1"
  [[ -d "$THEMES_DIR/$name" ]] || return 0

  echo "$name" >"$PREVIEW_TOKEN"
  sleep "$PREVIEW_DELAY"
  if [[ "$(cat "$PREVIEW_TOKEN" 2>/dev/null)" == "$name" && "$(current)" != "$name" ]]; then
    activate "$name"
  fi
}

menu() {
  local previous choice row
  previous="$(current)"
  row="$(list | grep -nxF -- "$previous" | cut -d: -f1 || true)"

  choice="$(list | rofi -dmenu -i -p theme \
    -selected-row "$((${row:-1} - 1))" \
    -on-selection-changed "$0 preview '{entry}'")" || true

  # Cancel any preview still waiting to fire.
  : >"$PREVIEW_TOKEN"

  if [[ -n "$choice" ]]; then
    set_theme "$choice"
  elif [[ -n "$previous" && "$(current)" != "$previous" ]]; then
    activate "$previous"
  fi
}

cycle() {
  local step="$1" themes active i
  mapfile -t themes < <(list)
  active="$(current)"

  for i in "${!themes[@]}"; do
    if [[ "${themes[$i]}" == "$active" ]]; then
      set_theme "${themes[$(((i + step + ${#themes[@]}) % ${#themes[@]}))]}"
      return
    fi
  done
  set_theme "${themes[0]}"
}

case "${1:-}" in
  list) list ;;
  current) current ;;
  set) set_theme "${2:?theme name required}" ;;
  next) cycle 1 ;;
  prev) cycle -1 ;;
  default) set_theme "$DEFAULT_THEME" ;;
  preview) preview "${2:?theme name required}" ;;
  generate) generate "${2:-}" ;;
  refresh) refresh "${2:-}" ;;
  menu) menu ;;
  ensure)
    if [[ ! -d "$CURRENT" && -d "$THEMES_DIR/$DEFAULT_THEME" ]]; then
      ln -sfn "$DEFAULT_THEME" "$CURRENT"
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac
