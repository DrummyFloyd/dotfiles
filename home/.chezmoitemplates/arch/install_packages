{{- /*
  vim:ft=bash.gotmpl:
*/ -}}
PACKAGES=(
{{- range .arch.pacman }}
  {{ . | quote }}
{{- end }}
)

# INFO: pacman -T prints unsatisfied targets only, locale independent and
# resolves provides. Exits 127 when something is missing.
mapfile -t MISSING_PACKAGES < <(pacman -T "${PACKAGES[@]}" || true)

if [[ ${#MISSING_PACKAGES[@]} -gt 0 ]]; then
  log_task "Installing packages: ${MISSING_PACKAGES[*]}"
  yay -S --needed --noconfirm "${MISSING_PACKAGES[@]}"
fi
