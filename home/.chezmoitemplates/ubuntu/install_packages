{{- /*
  vim:ft=bash.gotmpl:
*/ -}}
PACKAGES=(
{{- range .ubuntu.apt }}
  {{ . | quote }}
{{- end }}
{{- if .isWsl }}
{{- range .ubuntu.aptWsl }}
  {{ . | quote }}
{{- end }}
{{- end }}
)

MISSING_PACKAGES=()
INSTALLED_PACKAGES=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null | awk '$1 == "ii" { print $2 }')
for pkg in "${PACKAGES[@]}"; do
  if ! grep -qxF "${pkg}" <<<"${INSTALLED_PACKAGES}"; then
    MISSING_PACKAGES+=("${pkg}")
  fi
done

if [[ ${#MISSING_PACKAGES[@]} -gt 0 ]]; then
  log_task "Installing missing packages: ${MISSING_PACKAGES[*]}"
  sudo apt update && sudo apt install -y "${MISSING_PACKAGES[@]}"
fi
