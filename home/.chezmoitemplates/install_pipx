{{- /*
  vim:ft=bash.gotmpl:
  Usage: {{ template "install_pipx" .<os>.pipx }}
*/ -}}
PIPX_PACKAGES=(
{{- range . }}
  {{ . | quote }}
{{- end }}
)

MISSING_PIPX_PACKAGES=()
INSTALLED_PIPX_PACKAGES=$(pipx list --short | cut -d' ' -f1)
for pkg in "${PIPX_PACKAGES[@]}"; do
  if ! grep -qxF "${pkg}" <<<"${INSTALLED_PIPX_PACKAGES}"; then
    MISSING_PIPX_PACKAGES+=("${pkg}")
  fi
done

if [[ ${#MISSING_PIPX_PACKAGES[@]} -gt 0 ]]; then
  log_task "Installing missing pipx packages: ${MISSING_PIPX_PACKAGES[*]}"
  for pkg in "${MISSING_PIPX_PACKAGES[@]}"; do
    pipx install "${pkg}"
  done
fi
