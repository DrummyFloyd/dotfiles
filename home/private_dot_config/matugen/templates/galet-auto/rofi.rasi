/* Galet colours generated by matugen from the wallpaper; shapes from galet-dark. */
@import "../galet-dark/rofi.rasi"

* {
  surface: {{colors.surface_container.default.hex}};
  surface-raised: {{colors.surface_container_high.default.hex}};
  text: {{colors.on_surface.default.hex}};
  text-mute: {{colors.outline.default.hex}};
  warn: {{colors.tertiary.default.hex}};
}
