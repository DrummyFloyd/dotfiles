// Galet colours generated by matugen from the wallpaper.
// Only the coloured formats live here; the rest comes from galet-dark.
{
  "include": ["~/.config/themes/galet-dark/waybar.jsonc"],
  "clock": {
    "format": "<span size='8pt'><span color='{{colors.primary.default.hex}}'>●</span><span color='{{colors.tertiary.default.hex}}'>●</span><span color='{{colors.secondary.default.hex}}'>●</span></span>  {:%H:%M  <span color='{{colors.outline.default.hex}}'>%a %d %b</span>}",
    "calendar": {
      "format": {
        "months": "<span color='{{colors.on_surface.default.hex}}'><b>{}</b></span>",
        "days": "<span color='{{colors.outline.default.hex}}'>{}</span>",
        "weeks": "<span color='{{colors.outline_variant.default.hex}}'>W{}</span>",
        "weekdays": "<span color='{{colors.primary.default.hex}}'><b>{}</b></span>",
        "today": "<span color='{{colors.tertiary.default.hex}}'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "<span color='{{colors.outline.default.hex}}'>{icon}</span> {volume}%",
    "format-bluetooth": "<span color='{{colors.outline.default.hex}}'>{icon}</span> {volume}%",
    "format-bluetooth-muted": "<span color='{{colors.outline.default.hex}}'>󰝟</span> muted",
    "format-muted": "<span color='{{colors.outline.default.hex}}'>󰝟</span> muted"
  },
  "backlight": {
    "format": "<span color='{{colors.outline.default.hex}}'>{icon}</span> {percent}%"
  },
  "cpu": {
    "format": "<span color='{{colors.outline.default.hex}}'>󰻠</span> {usage}%"
  },
  "battery": {
    "format": "<span color='{{colors.outline.default.hex}}'>{icon}</span> {capacity}%",
    "format-charging": "<span color='{{colors.outline.default.hex}}'>󰂄</span> {capacity}%",
    "format-plugged": "<span color='{{colors.outline.default.hex}}'>󰚥</span> {capacity}%"
  }
}
