{{- /*
  vim:ft=gitconfig.gotmpl:
*/ -}}
[user]
  name = {{ .work.username }}
  email = {{ .work.email }}

# INFO: override personal identity, no gpg on work env most of the time
[commit]
  gpgsign = false

[core]
{{- if .work.sshKeyProvided }}
  sshCommand = ssh -F /dev/null -o IdentitiesOnly=yes -i {{ .work.sshKeyPath }}
{{- else }}
  sshCommand = ssh -F /dev/null -o IdentitiesOnly=yes -o IdentityAgent=${XDG_RUNTIME_DIR}/rbw/ssh-agent-socket -i ~/.ssh/rbw/work.pub
{{- end }}
