{{- /*
  vim:ft=gitconfig.gotmpl:
*/ -}}
[user]
  name = {{ .personal.username }}
  email = {{ .personal.email }}
  signingkey = 20AC86EE49130589

[commit]
	gpgsign = true

[core]
  sshCommand = ssh -F /dev/null -o IdentitiesOnly=yes -o IdentityAgent=${XDG_RUNTIME_DIR}/rbw/ssh-agent-socket -i ~/.ssh/rbw/personal.pub

[includeIf "gitdir:~/Documents/OSS/Github/**"]
  path = oss.github

[includeIf "gitdir:~/Documents/OSS/Gitlab/**"]
  path = oss.gitlab
