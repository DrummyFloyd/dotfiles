/* Pastel for rofi: same Dracula colours as wofi.css. */
* {
  bg: #282a36;
  bg-alt: #44475a;
  border: #6272a4;
  accent: #bd93f9;
  text: #f8f8f2;

  font: "FiraCode Nerd Font 12";
  background-color: transparent;
  text-color: @text;
}

window {
  width: 33%;
  padding: 5px;
  border: 2px;
  border-color: @bg-alt;
  background-color: @bg;
}

mainbox {
  spacing: 5px;
  children: [inputbar, listview];
}

inputbar {
  padding: 5px;
  spacing: 8px;
  border: 2px;
  border-color: @border;
  background-color: @bg-alt;
  children: [prompt, entry];
}

listview {
  lines: 7;
  scrollbar: false;
  fixed-height: false;
}

element {
  padding: 5px;
  spacing: 8px;
  border: 2px;
  border-color: transparent;
}

element selected {
  background-color: @bg-alt;
  border-color: @accent;
}

element-icon,
element-text {
  background-color: inherit;
  text-color: inherit;
}
