// Behaviour shared by every theme.
// The look (module layout, formats, icons) lives in ~/.local/state/theme/current/waybar.jsonc:
// on duplicate keys this file wins, so keep look-related keys out of it.
{
  "layer": "top",
  "position": "top",
  "include": ["~/.local/state/theme/current/waybar.jsonc"],
  "clock": {
    "timezone": "Europe/Paris",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
    },
    // Over the clock: scroll changes the month shown, right-click month/year.
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "window-rewrite-default": "",
    "window-rewrite": {
      "title<.*youtube.*>": "",
      "class<vesktop>": "",
      "class<Slack>": "󰒱",
      "class<com.rtosta.zapzap>": "󰖣",
      "title<.*Gmail.*>": "󰊫",
      "title<.*K9s.*>": "󱃾",
      "title<.*github.*>": "",
      "title<.*Gitlab.*>": "",
      "class<virt-manager>": "",
      "class<firefox>": "",
      "class<zen>": "",
      "class<Bitwarden>": "",
      "class<Google-chrome>": "",
      "class<VirtualBox Manager>": "",
      "title<.*stackoverflow.*>": "",
      "class<kitty>": "",
    },
  },
  "hyprland/submap": {
    // No max-length: submap names carry Pango markup that a cut would break.
    "tooltip": false,
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20,
    },
  },
  "pulseaudio": {
    "on-double-click": "uwsm app -- pavucontrol",
  },
  // Speakers left out: any playing media would light the island up.
  "privacy": {
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true },
    ],
  },
  // Refreshed by Hyprland on Caps_Lock release: keyboard-state reads the LED
  // before it changes and lags one toggle behind.
  "custom/capslock": {
    "exec": "~/.local/bin/scripts/capslock",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
  },
  "custom/updates": {
    "exec": "~/.local/bin/scripts/update-sys",
    "on-click": "~/.local/bin/scripts/update-sys update",
    "interval": 300,
    "tooltip": true,
  },
}
