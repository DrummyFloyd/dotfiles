/* Shapes only: the colours come from the active theme, see ~/.local/bin/scripts/theme */
@import url("file://{{ .chezmoi.homeDir }}/.local/state/theme/current/wlogout.css");

/* Symbolic icons take the button colour, and unlike the text of a button
   (wlogout can't centre it) they sit in the middle. The text, stuck at the
   bottom, shows the key of the button. */
button {
  border-width: 3px;
  border-style: solid;
  border-radius: 32px;
  text-shadow: none;
  box-shadow: none;
  /* The GTK theme rings the focused button, the first one on open, once a key
     is pressed (the shortcut that opens the menu is enough) */
  outline-style: none;
  margin: 0;
  background-repeat: no-repeat;
  background-position: center 40%;
  background-size: 35%;
  transition:
    background-color 0.2s ease-in-out,
    border-color 0.2s ease-in-out;
}

#lock {
  background-image: -gtk-icontheme("system-lock-screen-symbolic");
}

#logout {
  background-image: -gtk-icontheme("system-log-out-symbolic");
}

#reboot {
  background-image: -gtk-icontheme("view-refresh-symbolic");
}

#shutdown {
  background-image: -gtk-icontheme("system-shutdown-symbolic");
}

button label {
  font-family: "FiraCode Nerd Font";
  font-size: 16px;
}
